<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 이상 클라우드 백업·기기 이전. 칸·세션·출처(mist.db)만 넣고 원시 위치(fixes.db)는 뺀다 (DECISIONS D4) -->
<data-extraction-rules>
  <cloud-backup>
    <include domain="database" path="mist.db" />
    <include domain="database" path="mist.db-wal" />
    <include domain="database" path="mist.db-shm" />
  </cloud-backup>
  <device-transfer>
    <include domain="database" path="mist.db" />
    <include domain="database" path="mist.db-wal" />
    <include domain="database" path="mist.db-shm" />
  </device-transfer>
</data-extraction-rules>
